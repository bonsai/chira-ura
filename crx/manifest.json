{
  "manifest_version": 3,
  "name": "chira-ura / チラ裏",
  "version": "0.1.5",
  "description": "書いたら自動保存。メモとコピーだけの軽量メモ帳。箱はローカル / GDrive / GitHub / Box。",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "chira-ura"
  },
  "side_panel": {
    "default_path": "sidepanel/write.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "identity",
    "identity.email",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "version_name": "0.1.5-dev",
  "oauth2": {
    "client_id": "REPLACE_ME.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
