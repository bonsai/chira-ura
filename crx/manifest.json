{
  "manifest_version": 3,
  "name": "kami copi / 紙コピー",
  "version": "2.2.0",
  "description": "書いたら自動保存。メモ入力・コピーだけの超軽量メモ帳。箱はGDrive(GAS)がマスター。設定はCLI。",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "kami copi"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "identity",
    "identity.email"
  ],
  "host_permissions": [],
  "version_name": "2.2.0-dev",
  "oauth2": {
    "client_id": "REPLACE_ME.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
