{
  "name": "chira-ura",
  "version": "0.1.5-dev",
  "private": true,
  "description": "書いたら自動保存。メモとコピーだけの軽量 Chrome 拡張 + CLI（モノレポ構成）。",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'Packages: cli (chira-ura-cli), crx (chira-ura extension)'",
    "sync": "bash packages/cli/sync.sh",
    "install:posix": "bash packages/cli/install.sh",
    "install:windows": "pwsh -File packages/cli/install.ps1"
  },
  "devDependencies": {},
  "keywords": ["chrome-extension", "memo", "cli"],
  "license": "MIT"
}